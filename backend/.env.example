# ─────────────────────────────────────────────────────────────────────────────
# ChurnGuard Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or local: mongodb://localhost:27017)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Name of the MongoDB database
DB_NAME=churnguard

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS

# JWT signing algorithm — HS256 is recommended
JWT_ALGORITHM=HS256

# Token expiry in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Mode Configuration ────────────────────────────────────────────────────────
# Set to 'false' for live production (enforces real SMTP email delivery). Default is 'true'.
DEV_MODE=false

# ── Frontend Base URL (for Password Reset Links & Email Notifications) ──────────
FRONTEND_URL=https://churnguard-frontend.onrender.com

# ── CORS Configuration ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (e.g., in production: https://yourdomain.com)
# Localhost origins (http://localhost:5173, http://localhost:5174) are always supported by default.
# ALLOWED_ORIGINS=https://churnguard-frontend.onrender.com

# ── Email Provider Selection ──────────────────────────────────────────────────
# Choose which email backend to use:
#   smtp   — Direct SMTP (Gmail App Password, Outlook, SendGrid SMTP relay)
#   resend — Resend HTTP API (recommended for Render — bypasses SMTP port blocks)
#   brevo  — Brevo Transactional Email API (alternative HTTP provider)
#
# If SMTP port 587 is blocked by your hosting provider (common on Render free tier),
# switch to EMAIL_PROVIDER=resend or EMAIL_PROVIDER=brevo.
EMAIL_PROVIDER=smtp

# ── SMTP Email ────────────────────────────────────────────────────────────────
# Used when EMAIL_PROVIDER=smtp (default).
# --- Gmail ---
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate an App Password:   https://myaccount.google.com/apppasswords
#    (App name: "ChurnGuard" or similar)
# 3. Paste the 16-character password WITHOUT spaces as SMTP_PASSWORD.
# 4. SMTP_USERNAME and SMTP_FROM_EMAIL must be the SAME Gmail address used
#    to generate the App Password. Gmail rejects mismatches.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=abcdabcdabcdabcd
SMTP_FROM_EMAIL=your.email@gmail.com

# ── Resend API (EMAIL_PROVIDER=resend) ───────────────────────────────────────
# Sign up at https://resend.com — free tier: 100 emails/day, 3,000/month.
# Verify your sending domain (or use onboarding@resend.dev for testing).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Brevo API (EMAIL_PROVIDER=brevo) ─────────────────────────────────────────
# Sign up at https://www.brevo.com — free tier: 300 emails/day.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxx
# EMAIL_FROM_NAME=ChurnGuard
