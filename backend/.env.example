# ─────────────────────────────────────────────────────────────────────────────
# ChurnGuard Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or local: mongodb://localhost:27017)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Name of the MongoDB database
DB_NAME=churnguard

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS

# JWT signing algorithm — HS256 is recommended
JWT_ALGORITHM=HS256

# Token expiry in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Mode Configuration ────────────────────────────────────────────────────────
# Set to 'false' for live production (enforces real SMTP email delivery). Default is 'true'.
DEV_MODE=true

# ── CORS Configuration ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (e.g., in production: https://yourdomain.com)
# Localhost origins (http://localhost:5173, http://localhost:5174) are always supported by default.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── SMTP Email (for OTP delivery) ─────────────────────────────────────────────
# --- Gmail ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your.email@gmail.com
# SMTP_PASSWORD=your-16-char-app-password   # Gmail > Security > App Passwords
# SMTP_FROM_EMAIL=your.email@gmail.com
#
# --- Outlook / Hotmail ---
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USERNAME=your.email@outlook.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=your.email@outlook.com
#
# --- SendGrid ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM_EMAIL=noreply@yourdomain.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
