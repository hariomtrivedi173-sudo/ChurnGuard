# ============================================
# Python virtual environments
# ============================================
venv/
.venv/
env/
ENV/
*/venv/
*/.venv/

# ============================================
# Environment files (SECRETS - never commit)
# ============================================
.env
*.env
.env.*
.env.local
backend/.env
frontend/.env
frontend/.env.local
!.env.example
!*.env.example

# ============================================
# Python caches, bytecode and tools
# ============================================
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*/.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
.eggs/

# ============================================
# Uploaded avatars (keep folder via .gitkeep)
# ============================================
backend/uploads/avatars/*
!backend/uploads/avatars/.gitkeep

# ============================================
# Generated reports (keep folder via .gitkeep)
# ============================================
reports/*
!reports/.gitkeep

# ============================================
# Logs
# ============================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================
# Node dependencies and build output
# ============================================
node_modules/
dist/
frontend/dist/
.vite/
.cache/
coverage/

# ============================================
# Customer data and temporary files
# (uncomment if the files contain real customer data)
# ============================================
# *.csv
# *.xlsx
*.tmp
*.bak
*.swp

# ============================================
# Trained ML models
# (uncomment ONLY if you do not want models in Git.
#  If your app needs them after deploy, keep them tracked.)
# ============================================
# *.pkl
# *.joblib

# ============================================
# IDE and OS files
# ============================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini